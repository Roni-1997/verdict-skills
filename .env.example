# Verdict's active MCP uses Lighter binary outcomes.
# Research defaults to devnet when unset. Select testnet explicitly for staging.
LIGHTER_NETWORK=testnet
# Operator-verified creator account indices on this network, comma-separated.
# Without an allowlist, public discovery reads all creators and unsigned payload tools are disabled.
# LIGHTER_CREATORS=
# Select local execution authority explicitly. This assertion alone grants no trading permission.
# VERDICT_EXECUTION_MODE=per_order
# Hosted services use --connector-config with operator-managed credentials outside the repository.
# Never place venue signing keys, login tokens, or signed transactions in this file.

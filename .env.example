# Network: testnet (default while the kit is in development) or mainnet
VERDICT_NETWORK=testnet
# Venue name of the Verdict HIP-4 deployer (testnet venue during development)
VERDICT_VENUE=at
# Builder code attached to every order the kit builds. Address plus fee in tenths of a basis point.
VERDICT_BUILDER_ADDRESS=0x0000000000000000000000000000000000000000
VERDICT_BUILDER_FEE_TENTHS_BP=10
# HL_AGENT_PRIVATE_KEY is not read by the kit and belongs in no file, this one included: export it only in
# the shell that runs the caller's own signing step, a shell no agent drives, never on a hosted server
# (skills/verdict/references/sign-and-submit.md, Key handling).
# Optional: OddPool aggregator key for the cross-venue engine. Without it, compare_market and
# opportunities read the public Polymarket gamma and Kalshi APIs directly. The engine reads the key
# from the environment at call time and sends it to api.oddpool.com on every compare_market and
# opportunities call, so never set it on a hosted server. Not covered by the recorded fixtures.
# ODDPOOL_API_KEY=
# Optional: hosted mode. When set, list_markets, get_market, compare_market, fair_value, find_hedges and
# opportunities are answered by the Verdict API at this base URL (production: https://hyperverdict.xyz/api/v1;
# https only, no trailing slash) and the embedded engine does not run; orderbook, quote, positions,
# builder_status and the payload tools still read Hyperliquid directly. Set it on every hosted (--http) MCP
# deployment. The CLI flag --api <url> overrides it. Unset: the embedded engine.
# VERDICT_API_URL=

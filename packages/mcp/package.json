{
  "name": "@verdict/mcp",
  "version": "0.1.0",
  "private": false,
  "description": "Verdict MCP server: the core tool module over stdio and streamable HTTP",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Roni-1997/verdict-skills.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/Roni-1997/verdict-skills#readme",
  "type": "module",
  "bin": {
    "verdict-mcp": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vercel": {
      "types": "./dist/vercel.d.ts",
      "import": "./dist/vercel.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@verdict/core": "workspace:*",
    "express": "5.3.0",
    "jose": "6.2.12",
    "pg": "8.23.1",
    "viem": "2.55.13",
    "zod": "4.6.7"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  }
}
